{
  "task_id": "Task #127",
  "task_name": "Production Training with Optimal Hyperparameters on Kaggle",
  "dependencies": ["#120", "#121", "#122", "#123", "#124", "#125", "#126"],
  "dataset": {
    "name": "HyperKvasir",
    "num_classes": 23,
    "input_size": [3, 224, 224],
    "kaggle_path": "/kaggle/input/hyperkvasir-dataset-segmented/segmented-images",
    "kaggle_alt_path": "/kaggle/input/hyperkvasir/labeled-images",
    "local_path": "data/hyperkvasir",
    "split_ratios": {
      "train": 0.70,
      "val": 0.15,
      "test": 0.15
    }
  },
  "architecture": {
    "model_name": "CNN-CBAM-Transformer",
    "backbone": "ResNet50",
    "cbam_reduction": 16,
    "cbam_spatial_kernel": 7,
    "transformer_layers": 4,
    "transformer_heads": 8,
    "transformer_dim": 512,
    "transformer_ffn_dim": 2048,
    "pooling_mode": "hybrid",
    "handcrafted_fusion": {
      "enabled": true,
      "features": ["LBP", "Haralick_GLCM", "HSV_Histogram", "Gabor"],
      "handcrafted_dim": 128,
      "fused_dim": 640
    }
  },
  "training": {
    "full_epochs": 150,
    "early_stopping_patience": 15,
    "early_stopping_metric": "val_macro_f1",
    "early_stopping_mode": "max",
    "physical_batch_size": 32,
    "gradient_accumulation_steps": 4,
    "effective_batch_size": 256,
    "mixed_precision": true,
    "device": "cuda",
    "seed": 42
  },
  "optimizer": {
    "name": "AdamW",
    "discriminative_learning_rates": {
      "backbone_lr": 1e-05,
      "cbam_and_transformer_lr": 3e-05,
      "classifier_head_lr": 1e-04
    },
    "weight_decay": 0.0001,
    "betas": [0.9, 0.999],
    "eps": 1e-08
  },
  "scheduler": {
    "name": "CosineAnnealingLR_with_Warmup",
    "warmup_epochs": 12,
    "warmup_ratio": 0.08,
    "t_max": 150,
    "eta_min": 1e-06
  },
  "loss_function": {
    "name": "ClassBalancedFocalLoss",
    "gamma": 2.0,
    "alpha_mode": "class-balanced",
    "class_balanced_beta": 0.999,
    "label_smoothing": 0.1
  },
  "regularization": {
    "dropout": 0.1,
    "drop_path_rate": 0.1,
    "weight_decay": 0.0001
  },
  "augmentation": {
    "level": "Strong Medical",
    "transforms": [
      "RandomResizedCrop(224, scale=(0.75, 1.0))",
      "RandomHorizontalFlip(p=0.5)",
      "RandomVerticalFlip(p=0.5)",
      "ColorJitter(brightness=0.3, contrast=0.3, saturation=0.2, hue=0.1)",
      "GaussianBlur(kernel_size=3, sigma=(0.1, 2.0), p=0.2)",
      "OpticalDistortion(distort_limit=0.15, p=0.2)"
    ]
  },
  "sampling": {
    "sampler": "WeightedRandomSampler",
    "formula": "w_c = 1 / sqrt(N_c)"
  },
  "monitoring": {
    "wandb_project": "GIEndoDL-HyperKvasir",
    "wandb_run_name": "optimal-hybrid-production-kaggle",
    "checkpoint_dir": "checkpoints/optimal_production",
    "save_best_model": true,
    "save_last_model": true
  }
}
